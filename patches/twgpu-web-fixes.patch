+                },
+                bytemuck::cast_slice(&level0[..dst_layer_len * layers]),
+                wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(dst_w as u32 * 4),
+                    rows_per_image: Some(dst_h as u32),
+                },
+                wgpu::Extent3d {
+                    width: dst_w as u32,
+                    height: dst_h as u32,
+                    depth_or_array_layers: size.depth_or_array_layers,
