+/// 2x2 box filter, halving both dimensions (1 pixel stays 1 pixel).
+fn downscale(image: &image::RgbaImage) -> image::RgbaImage {
+    let (width, height) = (image.width(), image.height());
+    let (new_width, new_height) = ((width / 2).max(1), (height / 2).max(1));
+    let mut out = image::RgbaImage::new(new_width, new_height);
+    for y in 0..new_height {
+        for x in 0..new_width {
+            let mut acc = [0u32; 4];
+            for dy in 0..2 {
+                for dx in 0..2 {
+                    let sx = (x * 2 + dx).min(width - 1);
+                    let sy = (y * 2 + dy).min(height - 1);
+                    let pixel = image.get_pixel(sx, sy).0;
+                    for (channel, value) in acc.iter_mut().zip(pixel) {
+                        *channel += value as u32;
+                    }
+                }
+            }
+            let mut pixel = [0u8; 4];
+            for (channel, value) in pixel.iter_mut().zip(acc) {
+                *channel = (value / 4) as u8;
+            }
+            out.put_pixel(x, y, image::Rgba(pixel));
+        }
+    }
+    out
+}
